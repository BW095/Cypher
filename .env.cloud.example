# Copy this file to `.env` and adjust. `docker compose` reads it automatically.
#
# Cloud deployment — Amazon Bedrock for all LLM/embedding inference.
# No local GPU or model files needed.

# ── AWS Bedrock ──────────────────────────────────────────────────────────
# On EC2 with an IAM instance role that has AmazonBedrockFullAccess,
# leave ACCESS_KEY_ID and SECRET_ACCESS_KEY blank (auto-detected).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model IDs — defaults are set in config.py; override here if needed.
# BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_EXTRACTION_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Neo4j ────────────────────────────────────────────────────────────────
# CHANGE THIS before any networked deployment.
NEO4J_PASSWORD=change-me-to-a-strong-password

# ── Web UI ───────────────────────────────────────────────────────────────
# Port the web UI is served on (http://<ec2-ip>:<WEB_PORT>).
WEB_PORT=80

# ── Documents ────────────────────────────────────────────────────────────
# Host directory containing documents for server-side ingestion.
# Browser-uploaded files go into the backend's internal /data/uploads volume.
DOCUMENTS_DIR=./documents
