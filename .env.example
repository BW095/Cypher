# Copy this file to `.env` and adjust. `docker compose` reads it automatically.

# Neo4j password (used by both the neo4j service and the backend).
# CHANGE THIS before any networked deployment.
NEO4J_PASSWORD=change-me-to-a-strong-password

# Port the web UI is served on (http://localhost:<WEB_PORT>).
WEB_PORT=8080

# Host directory containing the documents Cypher should ingest. It is mounted
# into the backend at /documents — so in the UI, track folders like
# /documents/reports, /documents/logs, etc.
DOCUMENTS_DIR=./documents
